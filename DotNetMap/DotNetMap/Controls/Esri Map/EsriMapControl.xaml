<UserControl x:Class="DotNetMap.Controls.EsriMap.EsriMapConstrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DotNetMap.Controls.EsriMap"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid x:Name="MapContainer" Background="#FF292D31"/>
        <TextBlock x:Name="CameraData" 
                 Margin="0 17 0 0" 
                 HorizontalAlignment="Left" 
                 TextAlignment="Center" 
                 TextWrapping="NoWrap"
                 VerticalAlignment="TOP" 
                 Width="170"
                 Height="120"
                 Background="Transparent"/>
        <TextBlock x:Name="IsKeyValid" 
                 Margin="120 0 0 0" 
                 HorizontalAlignment="Left" 
                 TextAlignment="Center" 
                 TextWrapping="NoWrap"
                 VerticalAlignment="TOP" 
                 Width="50"
                 Background="Gray"/>
        <TextBox x:Name="ApiKey" 
                 HorizontalAlignment="Left" 
                 TextWrapping="NoWrap" 
                 Text="API KEY" 
                 VerticalAlignment="TOP" 
                 Width="120" 
                 TextChanged="TextBox_TextChanged"
                 BorderBrush="#FFABADB3"
                 BorderThickness="0"/>
    </Grid>
</UserControl>
