<UserControl x:Class="DotNetMap.Controls.EsriMap.EsriMapConstrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DotNetMap.Controls.EsriMap"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <esri:SceneView x:Name="SceneView" />
        <TextBox x:Name="ApiKey" HorizontalAlignment="Left" TextWrapping="NoWrap" Text="API KEY" VerticalAlignment="TOP" Width="120" TextChanged="TextBox_TextChanged"/>
    </Grid>
</UserControl>
