<UserControl x:Class="DotNetMap.Controls.EsriMap.EsriMapConstrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DotNetMap.Controls.EsriMap"
             xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid x:Name="MapContainer" Background="#FF292D31"/>
        <TextBox x:Name="ApiKey" 
                  FontSize="12"
                  HorizontalAlignment="Left" 
                  TextWrapping="NoWrap" 
                  Text="API KEY" 
                  VerticalAlignment="Top" 
                  Width="120" 
                  Height="18"
                  TextChanged="TextBox_TextChanged"
                  BorderBrush="#FFABADB3"
                  BorderThickness="0"/>
        <TextBlock x:Name="IsKeyValid" 
                  Margin="120 0 0 0" 
                  HorizontalAlignment="Left" 
                  TextAlignment="Center" 
                  TextWrapping="NoWrap"
                  VerticalAlignment="Top" 
                  Width="50"
                  Height="18"
                  Background="Gray"/>
        <ComboBox x:Name="TileComboBox"
                  Text="asd"
                  FontSize="10"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Margin="170 0 0 0"
                  Height="18"
                  Padding="10 1"
                  BorderThickness="0" 
                  Width="200" SelectionChanged="TileComboBox_SelectionChanged"/>
        <TextBlock x:Name="CameraData" 
                  Margin="0 17 0 0" 
                  Padding="5"
                  HorizontalAlignment="Left" 
                  TextAlignment="Left" 
                  TextWrapping="NoWrap"
                  VerticalAlignment="Top" 
                  Width="370"
                  Height="120"
                  Background="Gray"/>
        <Button Content="Rotate" 
                  Margin="0 140 0 0" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Width="50"
                  Height="30" Click="Button_Click"/>
    </Grid>
</UserControl>
